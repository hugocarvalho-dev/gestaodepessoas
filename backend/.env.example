# Base de dados PostgreSQL
DATABASE_URL="postgresql://hugo:admin@localhost:5432/project_gestao?schema=public"

# Porta do servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# Logs
LOG_LEVEL=debug

# ─── Multi-Tenancy ─────────────────────────────────────
# MASTER_DATABASE_URL: habilita modo multi-tenant
# Se comentado/vazio, o sistema roda em single-tenant usando DATABASE_URL
MASTER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/master_db"

# Configuração padrão do banco dos tenants
TENANT_DB_HOST="localhost"
TENANT_DB_PORT=5432
TENANT_DB_USER="postgres"
TENANT_DB_PASSWORD="postgres"

# Domínio base (produção — ex: 'gestao.app')
BASE_DOMAIN=""
