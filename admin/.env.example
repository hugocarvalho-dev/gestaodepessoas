# ─────────────────────────────────────────────────────────────
# Admin API — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────

# Banco MASTER (admin) — gerencia os tenants
MASTER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/master_db"

# Configuração padrão do banco dos tenants (mesma instância PostgreSQL)
TENANT_DB_HOST="localhost"
TENANT_DB_PORT=5432
TENANT_DB_USER="postgres"
TENANT_DB_PASSWORD="postgres"

# JWT para autenticação de admin
ADMIN_JWT_SECRET="admin-super-secret-key-change-in-production"
ADMIN_JWT_EXPIRES_IN="8h"

# Servidor
PORT=3002
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3003"
